  "sentences": [
    {
      "sent": 1,
      "s": 0.08,
      "e": 10.1091,
      "text": "Người già vẫn dặn: xó tối sau bếp ông Táo ở nhà cổ, tuyệt đối đừng quét sạch lớp tro đen hay lật chiếc bát sứt đặt úp, vì đó là chỗ trú của Ma Xó giữ nhà."
    },
    {
      "sent": 2,
      "s": 10.5691,
      "e": 17.6039,
      "text": "Đêm đầu về dọn căn nhà cũ bà ngoại để lại, Lan không tin, cầm đèn dầu bước vào gian bếp lạnh lẽo cuối nhà."
    },
    {
      "sent": 3,
      "s": 18.0139,
      "e": 28.043,
      "text": "Cô quét tung lớp tro rồi lật ngửa chiếc bát sứt sang một bên. Bếp than vụt tắt lạnh buốt, còn sau bệ đất chợt vang lên tiếng móng tay cào tro lạo xạo."
    },
    {
      "sent": 4,
      "s": 28.503,
      "e": 38.3867,
      "text": "Lan hạ đèn dầu soi sát góc tối. Trên nền tro mỏng hiện rõ hai dấu chân trần gầy guộc quay thẳng mặt vào vách tường, rồi hơi lạnh thổi phụt ngọn đèn."
    },
    {
      "sent": 5,
      "s": 39.1467,
      "e": 50.1642,
      "text": "Tàn than chợt bùng sáng đỏ quạch! Từ xó bếp, một bóng người gầy gập gối phủ đầy muội tro trườn ra, vươn tay đen đặc níu chặt cổ chân Lan sát ngưỡng cửa gian giữa."
    },
    {
      "sent": 6,
      "s": 50.6242,
      "e": 60.1445,
      "text": "Hoảng loạn, Lan với vội chiếc bát sứt cùng nắm tro ấm úp trả lại góc bếp. Bàn tay lạnh ngắt lập tức buông ra, rút lặng vào bóng tối."
    },
    {
      "sent": 7,
      "s": 60.6545,
      "e": 73.4307,
      "text": "Lan sống sót qua đêm ấy, nhưng từ đó không bước nổi qua cổng sau chạng vạng. Cứ nửa đêm, cô lặng lẽ đặt bát cơm nguội sát xó bếp, nơi bàn tay đen tro chậm rãi thò ra kéo vào bóng tối."
    }
  ],
