  "sentences": [
    {
      "sent": 1,
      "s": 0.08,
      "e": 8.3213,
      "text": "Dân chài miền sông nước có một luật ngầm sống còn: nghe tiếng kêu cứu dưới bến sông lúc hai giờ sáng, tuyệt đối không được nhảy xuống một mình."
    },
    {
      "sent": 2,
      "s": 8.7813,
      "e": 15.3656,
      "text": "Đêm tháng bảy sương giăng trắng xóa, ông Tư cầm đèn bão ra kiểm tra dây neo chiếc xuồng gỗ nơi bến đò vắng."
    },
    {
      "sent": 3,
      "s": 15.7756,
      "e": 25.2814,
      "text": "Mặt sông đang chảy bỗng đứng lặng như tờ. Một chiếc nón lá rách nát trôi ngược dòng nước, tấp thẳng vào mũi xuồng kèm tiếng bì bõm lạnh buốt."
    },
    {
      "sent": 4,
      "s": 25.7414,
      "e": 37.2821,
      "text": "Ông nghiêng đèn soi xuống làn nước đen ngòm. Dưới đám lục bình không có bóng phản chiếu của ông, mà là một bàn tay tái bệch đang nắm chặt dây neo, ghì mũi xuồng chúi hẳn xuống."
    },
    {
      "sent": 5,
      "s": 38.0421,
      "e": 49.7136,
      "text": "Chớp giật xé toạc màn đêm. Từ sát chân cầu gỗ, một bóng người ướt sũng với mái tóc bết bùn và đôi mắt sâu hoắm trồi lên, chộp cứng lấy cổ chân ông kéo mạnh xuống vực nước."
    },
    {
      "sent": 6,
      "s": 50.1736,
      "e": 58.4148,
      "text": "Đó là Ma Da tìm người thế mạng, oan hồn chết đuối bị giam dưới đáy sông lạnh, luôn chực chờ kéo người sống xuống thế chỗ vào giờ âm."
    },
    {
      "sent": 7,
      "s": 58.8748,
      "e": 63.4243,
      "text": "Ông Tư giằng thoát được, thất thần lao vào chòi canh rồi cài chặt then cửa."
    },
    {
      "sent": 8,
      "s": 63.9343,
      "e": 73.4982,
      "text": "Thế nhưng khi cúi nhìn sàn gỗ khô ráo, tim ông chết lặng. Ngay sau lưng ông, hai dấu chân ướt sũng bùn đen đã in sẵn từ lúc nào."
    }
  ],
